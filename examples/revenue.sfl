sfl 1.10

// Revenue by quarter, and the plan for the next year grown by a slider.
DataSource sales {
  mode: table
  fields {
    quarter: string
    amount: number
  }
}

DataSource plan {
  mode: record
  fields {
    growth: number
  }
}

Model report {
  Chart revenue {
    type: bar
    stacked: none
    data {
      categories: <- sales.quarter
      Axis x {
        min: 0
        max: 6
        step: 1
      }
      Axis y {
        min: 0
        max: 120
        step: 20
      }
      Series actual {
        values: <- sales.amount
        style {
          color: "#a8b4c4"
        }
      }
      Series next {
        label: "Next year"
        values: <- sales.amount * (1 + plan.growth / 100)
        style {
          color: "#3b6cf6"
        }
      }
    }
    style {
      fill: none
      stroke: none
      gridColor: "#e2e8f0"
      textColor: "#1e293b"
      barCornerRadius: 6
    }
    layout {
      position: 0, 0
      size: 620, 300
    }
  }

  Text growthLabel {
    text: <- "Growth next year: " + plan.growth + " %"
    layout {
      position: 0, 312
      size: 300, 22
    }
    style {
      fontSize: 13
      fontWeight: 600
      textColor: "#1e293b"
      textAlign: left
    }
  }

  Component growth {
    type: slider
    value: <-> plan.growth
    min: -20
    max: 40
    layout {
      position: 320, 306
      size: 300, 32
    }
    style {
      accent: "#3b6cf6"
    }
  }
}
